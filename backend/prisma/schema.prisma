generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  admin
  editor
  moderator
  sales
}

enum ProfileLanguage {
  ar
  en
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  tokenVersion    Int        @default(0)
  emailVerifiedAt DateTime?
  isVisitor       Boolean    @default(false)
  isOwner         Boolean    @default(false)
  staffRole       StaffRole?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile?
  emailCodes      EmailCode[]
  refreshTokens   RefreshToken[]
  profileChangeRequests ProfileChangeRequest[]
  legalAcceptances LegalAcceptance[]
  bookingBans      BookingBan[]
  bookings         Booking[]
  fakeReports      FakeReport[]
  notifications    Notification[]
  devices          Device[]
  favorites        Favorite[]
  recentPlaces     RecentPlace[]
  ratings          Rating[]
  placeChangeRequests PlaceChangeRequest[]
  ownedPlaces         PlaceOwner[]
}

model Profile {
  userId          String          @id
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  phone           String?         @unique
  phoneVerifiedAt DateTime?
  birthYear       Int?
  language        ProfileLanguage @default(ar)
}

enum ProfileChangeKind {
  name
  birth_year
}

enum ProfileChangeStatus {
  pending
  approved
  rejected
}

model ProfileChangeRequest {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ProfileChangeKind
  firstName String?
  lastName  String?
  birthYear Int?
  status    ProfileChangeStatus @default(pending)
  createdAt DateTime            @default(now())

  @@index([userId, status])
}

enum LegalKind {
  terms
  privacy
}

model LegalDocument {
  id          String          @id @default(cuid())
  kind        LegalKind
  language    ProfileLanguage
  body        String
  isCurrent   Boolean         @default(false)
  publishedAt DateTime        @default(now())
  acceptances LegalAcceptance[]

  @@index([kind, language, isCurrent])
}

model LegalAcceptance {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  acceptedAt DateTime      @default(now())

  @@unique([userId, documentId])
}

model SiteContact {
  id        String  @id @default("site")
  whatsapp  String?
  phone     String?
  email     String?
  facebook  String?
  instagram String?
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  type       String
  message    String
  visitorKey String
  createdAt  DateTime @default(now())

  @@index([visitorKey, createdAt])
}

enum SuggestionStatus {
  open
  done
  dismissed
}

model Suggestion {
  id         String           @id @default(cuid())
  name       String
  contact    String
  kind       String
  message    String
  placeId    String?
  visitorKey String
  status     SuggestionStatus @default(open)
  createdAt  DateTime         @default(now())

  @@index([visitorKey, createdAt])
  @@index([status, createdAt])
}

model EmailCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience   String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, audience, purpose])
}

model Area {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  places    Place[]
}

enum PlaceType {
  restaurant
  fast_food
  cafe
  hotel
  guest_house
  hostel
  motel
}

enum PlaceStatus {
  active
  temporarily_closed
  permanently_closed
  hidden
}

model Place {
  id          String      @id @default(cuid())
  nameAr      String
  nameEn      String
  type        PlaceType
  status      PlaceStatus @default(active)
  areaId      String
  area        Area        @relation(fields: [areaId], references: [id])
  addressAr   String?
  addressEn   String?
  latitude    Float?
  longitude   Float?
  isFeatured  Boolean     @default(false)
  starValue   Int?
  starSource  String?
  phone       String?
  website     String?
  email       String?
  facebook    String?
  instagram   String?
  descriptionAr String?
  descriptionEn String?
  claimCode   String?     @unique
  geocodeFailedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hours       PlaceHour[]
  amenities   PlaceAmenity[]
  photos      PlacePhoto[]
  offers      Offer[]
  events      Event[]
  bookingSettings PlaceBookingSettings?
  bookingBlackouts BookingBlackout[]
  bookingResponseHours BookingResponseHour[]
  bookings             Booking[]
  fakeReports          FakeReport[]
  favorites            Favorite[]
  recentPlaces         RecentPlace[]
  ratings              Rating[]
  changeRequests       PlaceChangeRequest[]
  owners               PlaceOwner[]
  subscriptions        Subscription[]
  payments             Payment[]

  @@index([areaId])
  @@index([status, type])
}

model PlaceHour {
  id        String     @id @default(cuid())
  placeId   String
  place     Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   Int
  closesAt  Int
  season    HourSeason @default(regular)

  @@index([placeId, dayOfWeek])
}

enum HourSeason {
  regular
  ramadan
}

model RamadanSeason {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
}

model PlaceBookingSettings {
  placeId         String  @id
  place           Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  acceptsBookings Boolean @default(false)
  horizonDays     Int     @default(14)
  noticeMinutes   Int     @default(60)
  maxParty        Int     @default(8)
  replyWindowMinutes Int  @default(60)
}

model BookingBlackout {
  id       String   @id @default(cuid())
  placeId  String
  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime

  @@index([placeId])
}

model BookingResponseHour {
  id        String @id @default(cuid())
  placeId   String
  place     Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   Int
  closesAt  Int

  @@index([placeId, dayOfWeek])
}

model BookingBan {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level    Int
  startsAt DateTime
  endsAt   DateTime?

  @@index([userId])
}

enum BookingStatus {
  waiting
  pending
  confirmed
  rejected
  expired
  cancelled_by_customer
  cancelled_by_owner
  attended
  no_show
}

model Booking {
  id                 String        @id @default(cuid())
  number             Int           @unique @default(autoincrement())
  clientKey          String
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId            String
  place              Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  startsAt           DateTime
  partySize          Int
  note               String?
  offerId            String?
  status             BookingStatus @default(pending)
  rejectionReason    String?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  notifications      Notification[]
  fakeReport         FakeReport?

  @@unique([userId, clientKey])
  @@index([userId, createdAt])
}

enum NotificationKind {
  booking_new
  booking_clock_started
  booking_confirmed
  booking_rejected
  booking_expired
  booking_cancelled_by_customer
  booking_cancelled_by_owner
  fake_reported
  fake_report_new
  fake_report_decided
  booking_ban_started
  booking_ban_lifted
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  bookingId String?
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

enum DevicePlatform {
  android
  ios
  web
}

model Device {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  String
  platform  DevicePlatform
  token     String
  createdAt DateTime       @default(now())

  @@unique([userId, audience, token])
}

enum FakeReportStatus {
  open
  confirmed
  rejected
}

model FakeReport {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  bookingId String?          @unique
  booking   Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  status    FakeReportStatus @default(open)
  message   String
  replies   FakeReportReply[]
  createdAt DateTime         @default(now())

  @@index([userId, status])
  @@index([placeId, createdAt])
}

model FakeReportReply {
  id        String     @id @default(cuid())
  reportId  String
  report    FakeReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime   @default(now())

  @@index([reportId])
}

model Favorite {
  userId    String
  placeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, placeId])
}

model RecentPlace {
  userId   String
  placeId  String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  viewedAt DateTime @default(now())

  @@id([userId, placeId])
  @@index([userId, viewedAt])
}

enum RatingStatus {
  held
  counted
  rejected
}

model Rating {
  id        String       @id @default(cuid())
  userId    String
  placeId   String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place        @relation(fields: [placeId], references: [id], onDelete: Cascade)
  stars     Int
  status    RatingStatus @default(held)
  createdAt DateTime     @default(now())

  @@unique([userId, placeId])
  @@index([placeId, status])
}

enum PlaceChangeKind {
  claim
  edit
  remove
  report
  unlink
}

enum PlaceChangeStatus {
  pending
  approved
  rejected
}

model PlaceChangeRequest {
  id           String            @id @default(cuid())
  placeId      String
  place        Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         PlaceChangeKind
  status       PlaceChangeStatus @default(pending)
  reason       String?
  payload      Json?
  decisionNote String?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@index([placeId, status])
  @@index([userId])
}

model PlaceOwner {
  placeId   String
  userId    String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([placeId, userId])
  @@index([userId])
}

model Subscription {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  endsAt    DateTime
  createdAt DateTime @default(now())

  @@index([placeId, endsAt])
}

enum PaymentMethod {
  cash
  syriatel_cash
  mtn_cash
  bank_transfer
  other
}

model Payment {
  id            String        @id @default(cuid())
  placeId       String
  place         Place         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String
  method        PaymentMethod
  item          String
  payer         String
  periodStart   DateTime?
  periodEnd     DateTime?
  receiptNumber String        @unique
  createdAt     DateTime      @default(now())
  void          PaymentVoid?

  @@index([placeId, createdAt])
}

model PaymentVoid {
  paymentId String   @id
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  reason    String
  voidedAt  DateTime @default(now())
}

model Amenity {
  id        String         @id @default(cuid())
  code      String         @unique
  nameAr    String
  nameEn    String
  sortOrder Int            @default(0)
  links     PlaceAmenity[]
}

model PlaceAmenity {
  placeId   String
  amenityId String
  approved  Boolean @default(false)
  sortOrder Int     @default(0)
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([placeId, amenityId])
  @@index([placeId, sortOrder])
}

enum PlacePhotoRole {
  gallery
  cover
  logo
}

model PlacePhoto {
  id        String         @id @default(cuid())
  placeId   String
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  objectKey String
  role      PlacePhotoRole @default(gallery)
  hidden    Boolean        @default(false)
  sortOrder Int            @default(0)

  @@index([placeId, sortOrder])
}

model Offer {
  id         String    @id @default(cuid())
  placeId    String
  place      Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  titleAr    String
  titleEn    String
  detailsAr  String
  detailsEn  String
  imageKey   String?
  startsAt   DateTime
  endsAt     DateTime
  published  Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([placeId, endsAt])
  @@index([published, startsAt, endsAt])
}

model Event {
  id            String   @id @default(cuid())
  placeId       String?
  place         Place?   @relation(fields: [placeId], references: [id], onDelete: SetNull)
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  addressAr     String?
  addressEn     String?
  phone         String?
  posterKey     String?
  published     Boolean  @default(false)
  startsAt      DateTime
  createdAt     DateTime @default(now())

  @@index([published, startsAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, audience])
}
