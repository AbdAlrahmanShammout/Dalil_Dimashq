generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  admin
  editor
  moderator
  sales
}

enum ProfileLanguage {
  ar
  en
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String?
  tokenVersion    Int        @default(0)
  emailVerifiedAt DateTime?
  isVisitor       Boolean    @default(false)
  isOwner         Boolean    @default(false)
  staffRole       StaffRole?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  profile         Profile?
  emailCodes      EmailCode[]
  refreshTokens   RefreshToken[]
}

model Profile {
  userId          String          @id
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName       String?
  lastName        String?
  phone           String?
  phoneVerifiedAt DateTime?
  birthYear       Int?
  language        ProfileLanguage @default(ar)
}

model EmailCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience   String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, audience, purpose])
}

model Area {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  places    Place[]
}

enum PlaceType {
  restaurant
  fast_food
  cafe
  hotel
  guest_house
  hostel
  motel
}

enum PlaceStatus {
  active
  temporarily_closed
  permanently_closed
  hidden
}

model Place {
  id          String      @id @default(cuid())
  nameAr      String
  nameEn      String
  type        PlaceType
  status      PlaceStatus @default(active)
  areaId      String
  area        Area        @relation(fields: [areaId], references: [id])
  addressAr   String?
  addressEn   String?
  latitude    Float?
  longitude   Float?
  isFeatured  Boolean     @default(false)
  starValue   Int?
  starSource  String?
  phone       String?
  website     String?
  email       String?
  facebook    String?
  instagram   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  hours       PlaceHour[]
  amenities   PlaceAmenity[]
  photos      PlacePhoto[]
  offers      Offer[]

  @@index([areaId])
  @@index([status, type])
}

model PlaceHour {
  id        String @id @default(cuid())
  placeId   String
  place     Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  opensAt   Int
  closesAt  Int

  @@index([placeId, dayOfWeek])
}

model Amenity {
  id     String         @id @default(cuid())
  code   String         @unique
  nameAr String
  nameEn String
  links  PlaceAmenity[]
}

model PlaceAmenity {
  placeId   String
  amenityId String
  approved  Boolean @default(false)
  sortOrder Int     @default(0)
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([placeId, amenityId])
  @@index([placeId, sortOrder])
}

enum PlacePhotoRole {
  gallery
  cover
  logo
}

model PlacePhoto {
  id        String         @id @default(cuid())
  placeId   String
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  objectKey String
  role      PlacePhotoRole @default(gallery)
  hidden    Boolean        @default(false)
  sortOrder Int            @default(0)

  @@index([placeId, sortOrder])
}

model Offer {
  id         String    @id @default(cuid())
  placeId    String
  place      Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  titleAr    String
  titleEn    String
  detailsAr  String
  detailsEn  String
  imageKey   String?
  startsAt   DateTime
  endsAt     DateTime
  published  Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([placeId, endsAt])
  @@index([published, startsAt, endsAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  audience  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, audience])
}
